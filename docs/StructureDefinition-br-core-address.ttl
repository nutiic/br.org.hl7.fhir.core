       fhir:ElementDefinition.short [ fhir:value "Período de validade do endereço" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Período de tempo em que o endereço esteve ou está em uso." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Este elemento é útil para manter histórico de endereços anteriores, especialmente importante para populações com mobilidade territorial." ]
     ]
  ] .

