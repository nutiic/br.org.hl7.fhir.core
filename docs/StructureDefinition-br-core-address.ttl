     fhir:index 0 ;
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "urn:iso:std:iso:3166" ] ;
       fhir:Coding.code [ fhir:value "BR" ] ;
       fhir:Coding.display [ fhir:value "Brazil" ]
     ]
  ] ;
  fhir:StructureDefinition.purpose [ fhir:value "Fornecer uma estrutura padronizada de endereçamento que contemple as particularidades do território brasileiro, especialmente no contexto da saúde indígena, permitindo a identificação precisa de aldeias, DSEIs e polos-base."] ;
