<https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-slot> a fhir:StructureDefinition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "br-core-slot"] ;
