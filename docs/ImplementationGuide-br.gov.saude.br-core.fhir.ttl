       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "BRCoreServiceRequest" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Este recurso restringe o recurso [ServiceRequest](https://hl7.org/fhir/R4/servicerequest.html) que registra uma solicitação de serviço, como investigações diagnósticas, tratamentos ou operações a serem realizadas" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
