       fhir:ImplementationGuide.definition.resource.name [ fhir:value "br-core-appointment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Perfil brasileiro do recurso FHIR R4 Appointment, utilizado para agendamento de atendimentos, procedimentos e interações de cuidado no contexto do SUS, RNDS, saúde suplementar e privada, incluindo marcação, remarcação e cancelamento, bem como gestão de participantes, datas/horários e justificativas." ] ;
