       fhir:ImplementationGuide.definition.resource.name [ fhir:value "BRCoreDiagnosticReport" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Este perfil restringe o recurso [DiagnosticReport](https://hl7.org/fhir/R4/diagnosticreport.html) que representa as descobertas e a interpretação de testes diagnósticos realizados em pacientes, grupos de pacientes, dispositivos e locais, e/ou espécimes derivados destes. O relatório inclui contexto clínico, como solicitação e informações do provedor, e alguma mistura de resultados atômicos, imagens, interpretações textuais e codificadas, e representação formatada de relatórios diagnósticos" ] ;
