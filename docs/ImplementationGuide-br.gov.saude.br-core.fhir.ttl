       fhir:ImplementationGuide.definition.resource.name [ fhir:value "br-core-careteam" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Este perfil restringe o recurso [CareTeam](https://hl7.org/fhir/R4/careteam.html) que inclui todas as pessoas e organizações que planejam participar da coordenação e prestação de cuidados a um paciente" ] ;
